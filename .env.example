# Copy this file to .env and fill in the values for your environment.
# Every VITE_ value is compiled into the browser bundle and can be read by
# anyone using the panel. Never put secrets (private keys, server API keys,
# passwords) in this file.

# Required. Backend API root, including /api/v1/.
# Production: https://node.hashtagbillionaire.com/api/v1/
VITE_API_BASE_URL=http://localhost:5000/api/v1/

# Optional. Host that serves uploaded images and files, without a trailing slash.
# Defaults to the origin of VITE_API_BASE_URL.
VITE_IMAGE_BASE_URL=

# Optional. Firebase web app config (Firebase console > Project settings >
# Your apps). Only needed if Firestore is used; nothing in the panel uses it today.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
